# Copy to: ~/.obsidian-story-sync/env
# This file is loaded by the Git post-commit hook (useful for GUI Git clients).

# REQUIRED per machine — absolute path to your Obsidian vault root
OBSIDIAN_VAULT_PATH="/Users/YOUR_USER/Documents/Obsidian/YourVault"

# Optional overrides (uncomment if needed)
# OBSIDIAN_PROJECT_ROOT="My Project"
# OBSIDIAN_IN_PROGRESS_FOLDER="In Progress"
# OBSIDIAN_JIRA_BASE_URL="https://your.atlassian.net/browse"
# OBSIDIAN_SEARCH_FOLDERS="In Progress,Ready to Tests - 1.1 - in QA"
# OBSIDIAN_TICKET_PATTERN="[A-Z][A-Z0-9]+-\\d+"
